# Copy to .env for LOCAL testing only (never commit .env). On Render, set these in
# the dashboard → Environment. Values below are placeholders.

# --- Shared secrets (TWO DISTINCT values — must match the Worker's secrets) ---
# Worker -> Render: sent as the X-Render-Api-Key header on every job POST.
RENDER_API_KEY=
# Render -> Worker: sent back on the result callback; the Worker verifies it.
RENDER_WEBHOOK_SECRET=

# Where to POST job results back to (the Worker's render-webhook route).
WORKER_WEBHOOK_URL=https://chhath-mgmt-api.shaharpura.workers.dev/?render-webhook=1

# --- GitHub (Render reads repo files + opens the PR itself) ---
GITHUB_TOKEN=
GITHUB_REPO=ashutoshroli/chhath-full-codebase

# --- AI model (Anthropic fallback; the active provider comes from the Worker) ---
ANTHROPIC_API_KEY=
AI_FIX_MODEL=claude-sonnet-4-5-20250929

# --- Google Drive OAuth (ONLY for bulk PDF / pdf_convert; same values as the Worker) ---
# Omit these for an AI-only deploy. Render returns PDF bytes to the Worker, which
# writes them to R2 — Render needs NO R2 credentials.
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=

# --- Public chatbot (/public-chat endpoint) ---
# Base URL of the PUBLIC portal Worker — the chatbot fetches the cached
# ?action=dataVersion + ?action=portalData from here (edge cache, no D1 hit).
PUBLIC_API_BASE=https://chhath-public-worker.shaharpura.com
# Base URL of the mgmt Worker (to fetch the public_chat provider via ?render-provider).
# Leave blank to derive it from WORKER_WEBHOOK_URL's origin.
MGMT_API_BASE=
# Comma-separated EXACT browser origins allowed to call /public-chat.
CHAT_ALLOWED_ORIGINS=https://chhath.shaharpura.com
# Per-IP rate limit for /public-chat.
CHAT_RATE_MAX=15
CHAT_RATE_WINDOW_MS=60000
# Neon Postgres connection string for chat logs (POOLED, sslmode=require).
# OPTIONAL: if unset, the chatbot still answers and just skips logging.
# See mgmt/db/neon/README.md.
DATABASE_URL=

# Render injects PORT automatically; only set it for local runs.
# PORT=10000
