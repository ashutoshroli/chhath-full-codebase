# Management portal runtime config. Only VITE_/PUBLIC_ vars reach the client.
# Set these in Vercel → Project Settings for production.

# The management API (UNCHANGED Cloudflare Worker). Required.
VITE_API_URL="https://mgmt-chhath-api.YOUR-SUBDOMAIN.workers.dev"

# Optional: Google Sign-In client id (enables the "Sign in with Google" button).
VITE_GOOGLE_CLIENT_ID=""

# Optional: Google Tag Manager id (analytics). Leave blank to disable.
VITE_GTM_ID=""
