---
// Announcement popup for the v2 public portal.
//
// WHAT IT IS
// A centered modal overlay showing the FIRST active "Public" popup authored in
// the mgmt Popup Management screen. Each popup has one or more slides (image /
// text / link); with more than one slide it autoplays on a per-slide timer with
// prev/next arrows and an "i / n" indicator. Ported behaviour-for-behaviour from
// Public/frontend (app.loadPopup / renderPopupSlide / scheduleAutoAdvance /
// setupPopupAutoPlayPause / popupPrev/NextSlide / closePopup), rebuilt as a
// self-contained Astro island so it drops into Layout and appears on every page.
//
// FETCHED FRESH ON EVERY LOAD (no localStorage dismissal memory) — matches the
// requirement that it shows again on each refresh, not just once per browser.
//
// WHY A BUNDLED ISLAND (no framework hydration, NO define:vars)
// Like Chatbot.astro, this is a handful of DOM handlers + timers. We keep the
// logic in a PLAIN <script> (NO define:vars) so Astro bundles it and its ESM
// imports resolve — it pulls apiBase from config.js, the version helpers from
// portalData.js, the audited XSS helpers from dom-escape.js, the Drive image
// helpers from drive.js, the pure popup logic from lib/popup.js, and the i18n
// strings from i18n.js. define:vars would implicitly make the script is:inline,
// which Astro does NOT bundle, so the `import`s would ship verbatim and fail.
//
// THE XSS-SAFETY CONTRACT (enforced in lib/popup.js buildSlideHtml)
// All four author-supplied slide values (image_url, text, link_url, link_text)
// are escaped, and image_url/link_url are gated by safeUrl (http(s) only) so a
// `javascript:`/`data:` URL renders no <img>/<a>. See src/lib/popup.js.
//
// FIRE-AND-FORGET
// The whole flow is wrapped so a version-resolution or activePopups fetch
// failure NEVER blocks the rest of the page (the popup is non-critical): a
// version failure falls back to the un-versioned URL, and any error is swallowed
// (console.debug), exactly mirroring the old site's fire-and-forget contract.
---

<!-- Overlay + card. Hidden by default (display:none) until the client script
     finds an eligible popup. Theme-aware via Tailwind dark: classes. -->
<div
  id="popup-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Announcement"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/50 p-4"
  style="display:none;"
>
  <div
    class="popup-card relative flex w-[min(420px,calc(100vw-2rem))] max-h-[85vh] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-slate-900"
  >
    <!-- Close (X) button -->
    <button
      id="popup-close"
      type="button"
      aria-label="Close"
      data-i18n-aria="close"
      class="absolute right-2 top-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/40 text-white hover:bg-black/60"
    >
      <span class="material-icons-round text-lg" aria-hidden="true">close</span>
    </button>

    <!-- Slide content. innerHTML is set from buildSlideHtml (escaped + gated). -->
    <div
      id="popup-slide-content"
      class="flex flex-col gap-3 overflow-y-auto p-5 pt-10 text-center text-slate-800 dark:text-slate-100 [&_.popup-slide-img]:mx-auto [&_.popup-slide-img]:max-h-64 [&_.popup-slide-img]:w-auto [&_.popup-slide-img]:rounded-lg [&_.popup-slide-text]:text-sm [&_.popup-slide-text]:leading-relaxed [&_.popup-slide-link]:font-semibold [&_.popup-slide-link]:text-brand-600 [&_.popup-slide-link]:underline dark:[&_.popup-slide-link]:text-brand-400"
    >
    </div>

    <!-- Nav: prev/next + "i / n" dots. Hidden until >1 slide. -->
    <div
      id="popup-slide-nav"
      class="hidden items-center justify-between border-t border-slate-200 px-4 py-3 dark:border-slate-800"
      style="display:none;"
    >
      <button
        id="popup-prev"
        type="button"
        aria-label="Previous"
        class="flex h-8 w-8 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <span class="material-icons-round" aria-hidden="true">chevron_left</span>
      </button>
      <span id="popup-slide-dots" class="text-xs font-semibold text-slate-500 dark:text-slate-400"></span>
      <button
        id="popup-next"
        type="button"
        aria-label="Next"
        class="flex h-8 w-8 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <span class="material-icons-round" aria-hidden="true">chevron_right</span>
      </button>
    </div>
  </div>
</div>

<!-- Client wiring. A PLAIN bundled <script> (NO define:vars) so Astro processes
     it and its ESM imports resolve. Mirrors Chatbot.astro's approach. -->
<script>
  import { apiBase } from '../config.js';
  import { buildDataVersionUrl, parseVersion } from '../lib/portalData.js';
  import { escapeHtml, safeUrl } from '../lib/dom-escape.js';
  import { driveImageUrl, driveImageFallbackUrl } from '../lib/drive.js';
  import {
    clampSlideDuration,
    nextIndex,
    prevIndex,
    pickFirstEligiblePopup,
    buildSlideHtml,
  } from '../lib/popup.js';
  import { t, normalizeLang, LANG_KEY } from '../i18n.js';

  (function () {
    var overlay = document.getElementById('popup-overlay');
    var content = document.getElementById('popup-slide-content');
    var navEl = document.getElementById('popup-slide-nav');
    var dotsEl = document.getElementById('popup-slide-dots');
    var closeBtn = document.getElementById('popup-close');
    var prevBtn = document.getElementById('popup-prev');
    var nextBtn = document.getElementById('popup-next');
    if (!overlay || !content) return; // markup missing — nothing to wire

    // --- Language (matches the header) --------------------------------------
    var lang = 'en';
    try { lang = normalizeLang(localStorage.getItem(LANG_KEY)); } catch (e) { lang = 'en'; }
    // Keep the localized aria-label / default link label in sync with a toggle.
    window.addEventListener('cpm:langchange', function (e) {
      lang = normalizeLang(e && e.detail && e.detail.lang);
      if (closeBtn) closeBtn.setAttribute('aria-label', t(lang, 'close'));
    });
    if (closeBtn) closeBtn.setAttribute('aria-label', t(lang, 'close'));

    // --- Auto-play state ----------------------------------------------------
    // `slides` holds the current popup's slides, `index` the shown one,
    // `_popupTimer` the pending setTimeout id (null = none), and `_popupPaused`
    // is set while the visitor interacts (hover / touch) so a slide never jumps
    // out from under them.
    var slides = [];
    var index = 0;
    var _popupTimer = null;
    var _popupPaused = false;

    function clearAutoAdvance() {
      if (_popupTimer) { clearTimeout(_popupTimer); _popupTimer = null; }
    }

    // (Re)arm the timer for the CURRENT slide. Called after every render so each
    // slide is shown for its own duration. Does nothing for a single-slide popup
    // or while paused. nextIndex gives the loop (wraps to 0 after the last).
    function scheduleAutoAdvance() {
      clearAutoAdvance();
      if (slides.length <= 1 || _popupPaused) return;
      var slide = slides[index];
      var ms = clampSlideDuration(slide && slide.duration_ms);
      _popupTimer = setTimeout(function () {
        _popupTimer = null;
        index = nextIndex(index, slides.length);
        renderSlide();
      }, ms);
    }

    // Render the current slide: escaped/gated HTML from the pure buildSlideHtml,
    // show/hide the nav + set the "i / n" dots only when >1 slide, then re-arm.
    function renderSlide() {
      var slide = slides[index];
      if (!slide) return;
      content.innerHTML = buildSlideHtml(slide, {
        escapeHtml: escapeHtml,
        safeUrl: safeUrl,
        driveImageUrl: driveImageUrl,
        driveImageFallbackUrl: driveImageFallbackUrl,
      });
      // Localize a link with no explicit label to the current language (the pure
      // module defaults to the English 'Learn more'; here we can localize it).
      var link = content.querySelector('.popup-slide-link');
      if (link && slide.link_url && !slide.link_text) {
        link.textContent = t(lang, 'learn_more');
      }
      if (slides.length > 1) {
        if (navEl) { navEl.style.display = 'flex'; navEl.classList.remove('hidden'); navEl.classList.add('flex'); }
        if (dotsEl) dotsEl.textContent = (index + 1) + ' / ' + slides.length;
      } else if (navEl) {
        navEl.style.display = 'none';
        navEl.classList.add('hidden');
        navEl.classList.remove('flex');
      }
      scheduleAutoAdvance();
    }

    // Pause auto-play while the visitor interacts, RESUME as soon as they stop —
    // so the popup never gets stuck. Bound ONCE (guarded by a data flag) so
    // repeated opens don't stack handlers.
    //
    // Touch pauses ONLY while the finger is down (touchstart) and resumes on
    // touchend/touchcancel — reproducing the fix for the persistent-pause
    // "kabhi chalta hai kabhi nahi" bug where a single tap killed auto-play for
    // the whole session on phones.
    function setupAutoPlayPause() {
      var card = overlay.querySelector('.popup-card');
      if (!card || card.dataset.autoplayBound === '1') return;
      card.dataset.autoplayBound = '1';
      var pause = function () { _popupPaused = true; clearAutoAdvance(); };
      var resume = function () { _popupPaused = false; scheduleAutoAdvance(); };
      card.addEventListener('mouseenter', pause);
      card.addEventListener('mouseleave', resume);
      card.addEventListener('touchstart', pause, { passive: true });
      card.addEventListener('touchend', resume, { passive: true });
      card.addEventListener('touchcancel', resume, { passive: true });
    }

    function show() {
      overlay.style.display = 'flex';
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    }
    function close() {
      clearAutoAdvance();
      overlay.style.display = 'none';
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }

    // Arrows: prev/next + re-render (which resets the timer for the new slide).
    if (prevBtn) prevBtn.addEventListener('click', function () {
      index = prevIndex(index, slides.length);
      renderSlide();
    });
    if (nextBtn) nextBtn.addEventListener('click', function () {
      index = nextIndex(index, slides.length);
      renderSlide();
    });
    if (closeBtn) closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.style.display !== 'none') close();
    });

    // --- Fire-and-forget load ----------------------------------------------
    // Resolve the data version the SAME way portalData does (fresh version ping
    // -> parseVersion), then fetch activePopups with that version (falling back
    // to the un-versioned URL on any version failure). The ENTIRE flow is
    // wrapped so a failure NEVER blocks the page — errors are swallowed via
    // console.debug, matching the old site's non-critical popup contract.
    function loadPopup() {
      resolveVersion()
        .then(function (version) {
          var vq = version ? ('&v=' + encodeURIComponent(version)) : '';
          return fetch(apiBase + '?action=activePopups' + vq).then(function (r) { return r.json(); });
        })
        .then(function (popups) {
          var popup = pickFirstEligiblePopup(popups);
          if (!popup) return; // nothing eligible — do nothing
          slides = popup.slides;
          index = 0;
          // Reset the pause flag on every fresh open: a stray touch/hover left
          // over from a previous session must not silently disable auto-play.
          _popupPaused = false;
          // Bind pause handlers BEFORE the first render so the render's
          // scheduleAutoAdvance() sees the correct (unpaused) state.
          setupAutoPlayPause();
          show();
          renderSlide();
        })
        .catch(function (err) {
          // Non-critical: never surface a popup failure to the visitor.
          if (typeof console !== 'undefined' && console.debug) {
            console.debug('Public popup load skipped:', err && err.message);
          }
        });
    }

    // Version resolution mirrors portalData: any failure resolves to '' so the
    // caller falls back to the un-versioned activePopups URL. Never rejects.
    function resolveVersion() {
      return fetch(buildDataVersionUrl(apiBase))
        .then(function (r) { return r && r.ok ? r.json() : null; })
        .then(function (vr) { return parseVersion(vr); })
        .catch(function () { return ''; });
    }

    loadPopup();
  })();
</script>
