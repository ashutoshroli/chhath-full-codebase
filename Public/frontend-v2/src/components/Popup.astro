---
---

<div
  id="popup-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Announcement"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/50 p-4"
  style="display:none;"
>
  <div
    class="popup-card relative flex w-[min(420px,calc(100vw-2rem))] max-h-[85vh] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-slate-900"
  >
    <button
      id="popup-close"
      type="button"
      aria-label="Close"
      data-i18n-aria="close"
      class="absolute right-2 top-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/40 text-white hover:bg-black/60"
    >
      <span class="material-icons-round text-lg" aria-hidden="true">close</span>
    </button>

    <div
      id="popup-slide-content"
      class="flex flex-col overflow-y-auto text-center text-slate-800 dark:text-slate-100 [&_.popup-slide-img]:block [&_.popup-slide-img]:w-full [&_.popup-slide-img]:max-h-[70vh] [&_.popup-slide-img]:object-contain [&_.popup-slide-text]:px-5 [&_.popup-slide-text]:pt-4 [&_.popup-slide-text]:text-sm [&_.popup-slide-text]:leading-relaxed [&_.popup-slide-link]:block [&_.popup-slide-link]:px-5 [&_.popup-slide-link]:pb-4 [&_.popup-slide-link]:pt-3 [&_.popup-slide-link]:font-semibold [&_.popup-slide-link]:text-brand-600 [&_.popup-slide-link]:underline dark:[&_.popup-slide-link]:text-brand-400"
    >
    </div>

    <div
      id="popup-slide-nav"
      class="hidden items-center justify-between border-t border-slate-200 px-4 py-3 dark:border-slate-800"
      style="display:none;"
    >
      <button
        id="popup-prev"
        type="button"
        aria-label="Previous"
        class="flex h-8 w-8 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <span class="material-icons-round" aria-hidden="true">chevron_left</span>
      </button>
      <span id="popup-slide-dots" class="text-xs font-semibold text-slate-500 dark:text-slate-400"></span>
      <button
        id="popup-next"
        type="button"
        aria-label="Next"
        class="flex h-8 w-8 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <span class="material-icons-round" aria-hidden="true">chevron_right</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { apiBase } from '../config.js';
  import { buildDataVersionUrl, parseVersion } from '../lib/portalData.js';
  import { escapeHtml, safeUrl } from '../lib/dom-escape.js';
  import { driveImageUrl, driveImageFallbackUrl } from '../lib/drive.js';
  import {
    clampSlideDuration,
    nextIndex,
    prevIndex,
    pickFirstEligiblePopup,
    buildSlideHtml,
  } from '../lib/popup.js';
  import { t, normalizeLang, LANG_KEY } from '../i18n.js';

  (function () {
    var overlay = document.getElementById('popup-overlay');
    var content = document.getElementById('popup-slide-content');
    var navEl = document.getElementById('popup-slide-nav');
    var dotsEl = document.getElementById('popup-slide-dots');
    var closeBtn = document.getElementById('popup-close');
    var prevBtn = document.getElementById('popup-prev');
    var nextBtn = document.getElementById('popup-next');
    if (!overlay || !content) return;

    var lang = 'en';
    try { lang = normalizeLang(localStorage.getItem(LANG_KEY)); } catch (e) { lang = 'en'; }
    window.addEventListener('cpm:langchange', function (e) {
      lang = normalizeLang(e && e.detail && e.detail.lang);
      if (closeBtn) closeBtn.setAttribute('aria-label', t(lang, 'close'));
    });
    if (closeBtn) closeBtn.setAttribute('aria-label', t(lang, 'close'));

    var slides = [];
    var index = 0;
    var _popupTimer = null;
    var _popupPaused = false;

    function clearAutoAdvance() {
      if (_popupTimer) { clearTimeout(_popupTimer); _popupTimer = null; }
    }

    function scheduleAutoAdvance() {
      clearAutoAdvance();
      if (slides.length <= 1 || _popupPaused) return;
      var slide = slides[index];
      var ms = clampSlideDuration(slide && slide.duration_ms);
      _popupTimer = setTimeout(function () {
        _popupTimer = null;
        index = nextIndex(index, slides.length);
        renderSlide();
      }, ms);
    }

    function renderSlide() {
      var slide = slides[index];
      if (!slide) return;
      content.innerHTML = buildSlideHtml(slide, {
        escapeHtml: escapeHtml,
        safeUrl: safeUrl,
        driveImageUrl: driveImageUrl,
        driveImageFallbackUrl: driveImageFallbackUrl,
      });
      var link = content.querySelector('.popup-slide-link');
      if (link && slide.link_url && !slide.link_text) {
        link.textContent = t(lang, 'learn_more');
      }
      if (slides.length > 1) {
        if (navEl) { navEl.style.display = 'flex'; navEl.classList.remove('hidden'); navEl.classList.add('flex'); }
        if (dotsEl) dotsEl.textContent = (index + 1) + ' / ' + slides.length;
      } else if (navEl) {
        navEl.style.display = 'none';
        navEl.classList.add('hidden');
        navEl.classList.remove('flex');
      }
      scheduleAutoAdvance();
    }

    function setupAutoPlayPause() {
      var card = overlay.querySelector('.popup-card');
      if (!card || card.dataset.autoplayBound === '1') return;
      card.dataset.autoplayBound = '1';
      var pause = function () { _popupPaused = true; clearAutoAdvance(); };
      var resume = function () { _popupPaused = false; scheduleAutoAdvance(); };
      card.addEventListener('mouseenter', pause);
      card.addEventListener('mouseleave', resume);
      card.addEventListener('touchstart', pause, { passive: true });
      card.addEventListener('touchend', resume, { passive: true });
      card.addEventListener('touchcancel', resume, { passive: true });
    }

    function show() {
      overlay.style.display = 'flex';
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    }
    function close() {
      clearAutoAdvance();
      overlay.style.display = 'none';
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }

    if (prevBtn) prevBtn.addEventListener('click', function () {
      index = prevIndex(index, slides.length);
      renderSlide();
    });
    if (nextBtn) nextBtn.addEventListener('click', function () {
      index = nextIndex(index, slides.length);
      renderSlide();
    });
    if (closeBtn) closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.style.display !== 'none') close();
    });

    function loadPopup() {
      resolveVersion()
        .then(function (version) {
          var vq = version ? ('&v=' + encodeURIComponent(version)) : '';
          return fetch(apiBase + '?action=activePopups' + vq).then(function (r) { return r.json(); });
        })
        .then(function (popups) {
          var popup = pickFirstEligiblePopup(popups);
          if (!popup) return;
          slides = popup.slides;
          index = 0;
          _popupPaused = false;
          setupAutoPlayPause();
          show();
          renderSlide();
        })
        .catch(function (err) {
          if (typeof console !== 'undefined' && console.debug) {
            console.debug('Public popup load skipped:', err && err.message);
          }
        });
    }

    function resolveVersion() {
      return fetch(buildDataVersionUrl(apiBase))
        .then(function (r) { return r && r.ok ? r.json() : null; })
        .then(function (vr) { return parseVersion(vr); })
        .catch(function () { return ''; });
    }

    if (!window.__cpmPopupBooted) {
      window.__cpmPopupBooted = true;
      loadPopup();
    }
  })();
</script>
