---
// Site header for the v2 public portal.
//
// THE THREE CONTROLS, GROUPED TOGETHER
// Per the explicit request, the language toggle, the year dropdown, and the
// dark/light theme toggle live SIDE BY SIDE in the header. Phase 1 wires the
// language and theme toggles fully; the year dropdown is a placeholder that
// Phase 2 will populate from the portal data payload.
//
// The interactive bits run in a small inline <script>: no framework hydration
// is needed for three simple controls, which keeps the page fast. UI labels are
// rendered server-side from the ported i18n dictionary, and the language toggle
// re-applies data-i18n text on the client so switching is instant and offline.
import { t, T, LANG_KEY, LANGS } from '../i18n.js';
import { mgmtLoginUrl } from '../config.js';

// Server-render everything in the default language; the client script re-applies
// the saved language on load and on toggle.
const lang = 'en';

// The real site routes. Each new Astro page is its own URL (multi-page static
// site), so the nav links to concrete paths (Phase 2 shipped placeholders).
const navItems = [
  { href: '/', key: 'nav_home' },
  { href: '/expenses', key: 'nav_expenses' },
  { href: '/loans', key: 'nav_loans' },
  { href: '/committee', key: 'nav_committee' },
  { href: '/downloads', key: 'nav_downloads' },
];

// Current path for active-state styling. Astro serves '/expenses' and, with the
// default trailing-slash handling, may render '/expenses/'; strip a trailing
// slash (except the root) so both forms match the same nav item.
const rawPath = Astro.url.pathname;
const currentPath = rawPath.length > 1 ? rawPath.replace(/\/$/, '') : rawPath;
const isActive = (href) => currentPath === href;
---

<!-- VIEW-TRANSITIONS STRATEGY: transition:persist.
     The header (theme toggle + language toggle + #year-select) is marked
     transition:persist so its DOM and its already-bound click handlers + the
     in-memory `lang` state SURVIVE client swaps unchanged. That means the inline
     IIFE below binds its listeners exactly ONCE (on the real load) and is never
     re-run on navigation, so there is no risk of double-bound toggles.
     CAVEAT (year options): #year-select lives inside this persisted header, so
     its <option>s persist too — but each destination page's populateYears()
     runs on astro:page-load and REPLACES yearSel.innerHTML, so the year list is
     always refreshed for the new page (see the data pages).
     THEME across swaps: the no-flash <head> script sets the `dark` class on
     <html> on the real load; View Transitions does NOT replace the <html>
     element on a swap, so the theme class simply persists — no re-apply needed. -->
<header
  transition:persist
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <!-- Brand: emblem + bilingual title.
         min-w-0 on the anchor AND the text wrapper lets flexbox actually shrink
         the brand below its content width on narrow screens (a flex child will
         not shrink past its intrinsic content size without min-w-0), and
         truncate keeps the long bilingual title on one line each so it can never
         push into the grouped controls. The logo stays flex-none. -->
    <a href="/" class="flex min-w-0 items-center gap-2" aria-label="Home">
      <img
        src="/logo.svg"
        alt="Navyuvak Chhath Puja Samiti"
        width="40"
        height="40"
        class="h-10 w-10 flex-none"
        decoding="async"
      />
      <span class="min-w-0 leading-tight">
        <span class="block truncate text-base font-bold text-brand-600 dark:text-brand-400" data-i18n="app_title">
          {t(lang, 'app_title')}
        </span>
        <span class="block truncate text-xs text-slate-500 dark:text-slate-400" data-i18n="app_subtitle">
          {t(lang, 'app_subtitle')}
        </span>
      </span>
    </a>

    <!-- Desktop nav: real routes with active-state styling. -->
    <nav class="hidden items-center gap-5 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`transition-colors hover:text-brand-500 ${isActive(item.href) ? 'font-bold text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-300'}`}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-i18n={item.key}
        >{t(lang, item.key)}</a>
      ))}
    </nav>

    <!-- THE THREE CONTROLS, grouped together.
         flex-none keeps the whole group at its natural width so it never shrinks
         or wraps into the brand; the brand (with min-w-0 + truncate) absorbs the
         squeeze instead. A slightly tighter gap on the smallest screens
         (gap-1.5) widens to gap-2 at sm so all three controls stay tappable at
         ~320-375px without overlapping the title. -->
    <div class="flex flex-none items-center gap-1.5 sm:gap-2">
      <!-- 1) Language toggle -->
      <button
        id="lang-toggle"
        type="button"
        class="rounded-md border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500 hover:text-brand-600 dark:border-slate-700 dark:text-slate-200"
        aria-label="Toggle language"
      >
        <span data-lang-label>हिं</span>
      </button>

      <!-- 2) Year dropdown (placeholder — populated from data in Phase 2) -->
      <label class="sr-only" for="year-select" data-i18n="year">{t(lang, 'year')}</label>
      <select
        id="year-select"
        class="w-auto min-w-[3.5rem] max-w-[6rem] truncate rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
        aria-label="Select year"
      >
        <option value="">{t(lang, 'year')}</option>
      </select>

      <!-- 3) Theme (dark/light) toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md border border-slate-300 px-2 py-1 text-slate-700 hover:border-brand-500 hover:text-brand-600 dark:border-slate-700 dark:text-slate-200"
        aria-label="Toggle dark mode"
      >
        <span class="material-icons-round text-base align-middle" data-theme-icon aria-hidden="true">dark_mode</span>
      </button>

      <!-- Login link (management portal; URL is env-driven, never hardcoded here) -->
      <a
        id="mgmt-login"
        href={mgmtLoginUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-md bg-brand-500 px-3 py-1 text-xs font-semibold text-white hover:bg-brand-600 sm:inline-block"
        data-i18n="login"
      >
        {t(lang, 'login')}
      </a>
    </div>
  </div>

  <!-- Mobile bottom-nav: same real routes + active state as the desktop nav. -->
  <nav
    class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-around border-t border-slate-200 bg-white/95 py-2 text-xs backdrop-blur dark:border-slate-800 dark:bg-slate-950/95 md:hidden"
    aria-label="Mobile navigation"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`px-2 ${isActive(item.href) ? 'font-bold text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-300'}`}
        aria-current={isActive(item.href) ? 'page' : undefined}
        data-i18n={item.key}
      >{t(lang, item.key)}</a>
    ))}
  </nav>
</header>

<!-- Client wiring for the three controls. Kept inline (no framework) so the
     controls work the instant the page loads. The i18n dictionary and the
     localStorage key are injected as JSON via define:vars so the client uses the
     exact same strings/key as the server render — no duplicated dictionary. -->
<script define:vars={{ T, LANG_KEY, LANGS }}>
  (function () {
    var html = document.documentElement;

    // --- THEME (dark/light) -------------------------------------------------
    // The no-flash script in <head> already set the initial class; here we just
    // reflect state in the icon and persist the user's explicit choice.
    var themeBtn = document.getElementById('theme-toggle');
    var themeIcon = themeBtn && themeBtn.querySelector('[data-theme-icon]');

    function syncThemeIcon() {
      if (!themeIcon) return;
      // Show the icon for the action the click will perform.
      themeIcon.textContent = html.classList.contains('dark') ? 'light_mode' : 'dark_mode';
    }
    syncThemeIcon();

    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var nowDark = html.classList.toggle('dark');
        try {
          localStorage.setItem('theme', nowDark ? 'dark' : 'light');
        } catch (e) {
          /* private mode — session-only toggle is fine */
        }
        syncThemeIcon();
      });
    }

    // --- LANGUAGE -----------------------------------------------------------
    function normalizeLang(l) {
      return l === 'hi' ? 'hi' : 'en';
    }
    function tr(l, key) {
      var lang = normalizeLang(l);
      return (T[lang] && T[lang][key]) || T.en[key] || key;
    }

    var lang = 'en';
    try {
      lang = normalizeLang(localStorage.getItem(LANG_KEY));
    } catch (e) {
      lang = 'en';
    }

    var langBtn = document.getElementById('lang-toggle');
    var langLabel = langBtn && langBtn.querySelector('[data-lang-label]');

    // Re-apply every static string tagged with data-i18n, update <html lang>,
    // and set the toggle to show the OTHER language's short label.
    function applyLang() {
      html.setAttribute('lang', lang);
      var nodes = document.querySelectorAll('[data-i18n]');
      for (var i = 0; i < nodes.length; i++) {
        var key = nodes[i].getAttribute('data-i18n');
        nodes[i].textContent = tr(lang, key);
      }
      // Re-apply placeholders tagged with data-i18n-placeholder. WHY this lives
      // here (with the toggle) rather than only in the Home island: the toggle
      // owns the language contract, so the general [data-i18n-placeholder] loop
      // belongs alongside the [data-i18n] loop, mirroring the old
      // Public/frontend/script.js (~line 246). This way ANY placeholder outside
      // the Home island (a future search box, filter, etc.) re-localizes for
      // free, instead of silently freezing in the boot-time language. The Home
      // island keeps its own explicit placeholder set as harmless
      // belt-and-suspenders: it runs on first boot (before any toggle) and after
      // its cpm:langchange re-render, and setting the same attribute twice is a
      // no-op.
      var phNodes = document.querySelectorAll('[data-i18n-placeholder]');
      for (var p = 0; p < phNodes.length; p++) {
        var phKey = phNodes[p].getAttribute('data-i18n-placeholder');
        phNodes[p].setAttribute('placeholder', tr(lang, phKey));
      }
      if (langLabel) {
        // Offer the language you'd switch TO.
        langLabel.textContent = lang === 'hi' ? 'EN' : 'हिं';
      }
    }
    applyLang();

    // RE-LOCALIZE AFTER CLIENT SWAPS.
    // Under View Transitions the header is persisted (this script runs once) but
    // the SWAPPED-IN page content is server-rendered in English (`const lang =
    // 'en'` in each page). After every swap we re-run applyLang() so the new
    // page's [data-i18n] / [data-i18n-placeholder] nodes are localized to the
    // saved language. We call applyLang() ONLY (never re-add listeners), reading
    // the same in-memory `lang` (kept in sync with LANG_KEY) so it matches the
    // persisted toggle state. Registered once (this IIFE runs once). Guarded so
    // repeated navigations never stack the handler even if Astro were to re-run
    // the script for any reason.
    if (!window.__cpmHeaderSwapBound) {
      window.__cpmHeaderSwapBound = true;
      document.addEventListener('astro:after-swap', function () { applyLang(); });
    }

    if (langBtn) {
      langBtn.addEventListener('click', function () {
        lang = lang === 'hi' ? 'en' : 'hi';
        try {
          localStorage.setItem(LANG_KEY, lang);
        } catch (e) {
          /* private mode — session-only language is fine */
        }
        applyLang();
        // Notify data-driven islands (the Home budget hero + contributors list)
        // that the language changed, so they re-localize their DATA — not just the
        // static [data-i18n] labels this header re-applies. A custom event is the
        // cleanest contract here: no shared bundle-level global, and every island
        // that cares can subscribe independently.
        try {
          window.dispatchEvent(new CustomEvent('cpm:langchange', { detail: { lang: lang } }));
        } catch (e) {
          /* CustomEvent unsupported (very old browser) — labels still switched */
        }
      });
    }
  })();
</script>
