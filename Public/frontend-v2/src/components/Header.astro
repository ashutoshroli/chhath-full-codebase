---
import { t, T, LANG_KEY, LANGS } from '../i18n.js';
import { mgmtLoginUrl } from '../config.js';
import { normalizePath, isActivePath } from '../lib/activeNav.js';

const lang = 'en';

const navItems = [
  { href: '/', key: 'nav_home', icon: 'home' },
  { href: '/expenses', key: 'nav_expenses', icon: 'receipt_long' },
  { href: '/loans', key: 'nav_loans', icon: 'handshake' },
  { href: '/committee', key: 'nav_committee', icon: 'groups' },
  { href: '/downloads', key: 'nav_downloads', icon: 'download' },
];

const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href) => isActivePath(currentPath, href);
---

<header
  transition:persist
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 overflow-hidden px-3 py-3 sm:gap-3 sm:px-4">
    <a href="/" class="flex min-w-0 items-center gap-2" aria-label="Home">
      <img
        src="/logo.svg"
        alt="Navyuvak Chhath Puja Samiti"
        width="40"
        height="40"
        class="h-10 w-10 flex-none"
        decoding="async"
      />
      <span class="min-w-0 leading-tight">
        <span class="block truncate text-base font-bold text-brand-600 dark:text-brand-400" data-i18n="app_title">
          {t(lang, 'app_title')}
        </span>
        <span class="hidden truncate text-xs text-slate-500 dark:text-slate-400 xs:block" data-i18n="app_subtitle">
          {t(lang, 'app_subtitle')}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-href={item.href}
          class={`transition-colors hover:text-brand-500 ${isActive(item.href) ? 'font-bold text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-300'}`}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-i18n={item.key}
        >{t(lang, item.key)}</a>
      ))}
    </nav>

    <div class="flex flex-none items-center gap-1.5 sm:gap-2">
      <button
        id="lang-toggle"
        type="button"
        class="flex-none rounded-md border border-slate-300 px-1.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500 hover:text-brand-600 dark:border-slate-700 dark:text-slate-200 sm:px-2"
        aria-label="Toggle language"
      >
        <span data-lang-label>हिं</span>
      </button>

      <label class="sr-only" for="year-select" data-i18n="year">{t(lang, 'year')}</label>
      <select
        id="year-select"
        class="w-auto min-w-[2.75rem] max-w-[5rem] truncate rounded-md border border-slate-300 bg-white px-1.5 py-1 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 sm:min-w-[3.5rem] sm:max-w-[6rem] sm:px-2"
        aria-label="Select year"
      >
        <option value="">{t(lang, 'year')}</option>
      </select>

      <button
        id="theme-toggle"
        type="button"
        class="flex-none rounded-md border border-slate-300 px-1.5 py-1 text-slate-700 hover:border-brand-500 hover:text-brand-600 dark:border-slate-700 dark:text-slate-200 sm:px-2"
        aria-label="Toggle dark mode"
      >
        <span class="material-icons-round text-base align-middle" data-theme-icon aria-hidden="true">dark_mode</span>
      </button>

      <a
        id="mgmt-login"
        href={mgmtLoginUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-md bg-brand-500 px-3 py-1 text-xs font-semibold text-white hover:bg-brand-600 sm:inline-block"
        data-i18n="login"
      >
        {t(lang, 'login')}
      </a>
    </div>
  </div>
</header>


<nav
  class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-around border-t border-slate-200 bg-white/95 py-2 text-xs backdrop-blur dark:border-slate-800 dark:bg-slate-950/95 md:hidden"
  aria-label="Mobile navigation"
>
  {navItems.map((item) => (
    <a
      href={item.href}
      data-nav-href={item.href}
      class={`flex w-1/5 flex-col items-center gap-0.5 px-1 leading-none ${isActive(item.href) ? 'font-bold text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-300'}`}
      aria-current={isActive(item.href) ? 'page' : undefined}
    >
      {/* Icon above the label — the native app tab-bar look both reference
          portals use. aria-hidden because the adjacent label already names the
          destination, so screen readers must not announce the glyph name. */}
      <span class="material-icons-round text-xl" aria-hidden="true">{item.icon}</span>
      {/* ⚠️ data-i18n sits on THIS label span, NOT on the parent <a>. The
          language script re-localizes by assigning node.textContent, which would
          WIPE the sibling icon span if the hook were on the <a>. Both reference
          portals tag the label span for the same reason. */}
      <span data-i18n={item.key}>{t(lang, item.key)}</span>
    </a>
  ))}
</nav>

<script define:vars={{ T, LANG_KEY, LANGS }}>
  (function () {
    var html = document.documentElement;

    var themeBtn = document.getElementById('theme-toggle');
    var themeIcon = themeBtn && themeBtn.querySelector('[data-theme-icon]');

    function syncThemeIcon() {
      if (!themeIcon) return;
      themeIcon.textContent = html.classList.contains('dark') ? 'light_mode' : 'dark_mode';
    }
    syncThemeIcon();

    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var nowDark = html.classList.toggle('dark');
        try {
          localStorage.setItem('theme', nowDark ? 'dark' : 'light');
        } catch (e) {
        }
        syncThemeIcon();
      });
    }

    function normalizeLang(l) {
      return l === 'hi' ? 'hi' : 'en';
    }
    function tr(l, key) {
      var lang = normalizeLang(l);
      return (T[lang] && T[lang][key]) || T.en[key] || key;
    }

    var lang = 'en';
    try {
      lang = normalizeLang(localStorage.getItem(LANG_KEY));
    } catch (e) {
      lang = 'en';
    }

    var langBtn = document.getElementById('lang-toggle');
    var langLabel = langBtn && langBtn.querySelector('[data-lang-label]');

    function applyLang() {
      html.setAttribute('lang', lang);
      var nodes = document.querySelectorAll('[data-i18n]');
      for (var i = 0; i < nodes.length; i++) {
        var key = nodes[i].getAttribute('data-i18n');
        nodes[i].textContent = tr(lang, key);
      }
      var phNodes = document.querySelectorAll('[data-i18n-placeholder]');
      for (var p = 0; p < phNodes.length; p++) {
        var phKey = phNodes[p].getAttribute('data-i18n-placeholder');
        phNodes[p].setAttribute('placeholder', tr(lang, phKey));
      }
      if (langLabel) {
        langLabel.textContent = lang === 'hi' ? 'EN' : 'हिं';
      }
    }
    applyLang();

    if (!window.__cpmHeaderSwapBound) {
      window.__cpmHeaderSwapBound = true;
      document.addEventListener('astro:after-swap', function () { applyLang(); });
    }

    if (langBtn) {
      langBtn.addEventListener('click', function () {
        lang = lang === 'hi' ? 'en' : 'hi';
        try {
          localStorage.setItem(LANG_KEY, lang);
        } catch (e) {
        }
        applyLang();
        try {
          window.dispatchEvent(new CustomEvent('cpm:langchange', { detail: { lang: lang } }));
        } catch (e) {
        }
      });
    }
  })();
</script>


<script>
  import { normalizePath, isActivePath } from '../lib/activeNav.js';

  var ACTIVE_CLASSES = ['font-bold', 'text-brand-600', 'dark:text-brand-400'];
  var BASE_CLASSES = ['text-slate-600', 'dark:text-slate-300'];

  function updateActiveNav() {
    var current = normalizePath(location.pathname);
    var links = document.querySelectorAll('[data-nav-href]');
    for (var i = 0; i < links.length; i++) {
      var link = links[i];
      var active = isActivePath(current, link.getAttribute('data-nav-href'));
      if (active) {
        link.classList.add.apply(link.classList, ACTIVE_CLASSES);
        link.classList.remove.apply(link.classList, BASE_CLASSES);
        link.setAttribute('aria-current', 'page');
      } else {
        link.classList.remove.apply(link.classList, ACTIVE_CLASSES);
        link.classList.add.apply(link.classList, BASE_CLASSES);
        link.removeAttribute('aria-current');
      }
    }
  }

  updateActiveNav();
  if (!window.__cpmActiveNavBound) {
    window.__cpmActiveNavBound = true;
    document.addEventListener('astro:page-load', updateActiveNav);
  }
</script>
