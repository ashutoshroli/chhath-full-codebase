---
// Base HTML shell for every v2 page.
//
// Responsibilities:
//   - No-flash theme: apply the `dark` class BEFORE first paint so users never
//     see a light flash before their saved dark theme kicks in.
//   - Non-render-blocking fonts (Inter + Material Icons) so the web font fetch
//     stays off the critical path (better LCP), matching the old site's pattern.
//   - Env-driven SEO defaults in <head>, sourced from the shared config module
//     so the canonical/OG origin is never hardcoded.
//   - Render the Header (with the three grouped controls) and a page <slot/>.
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Chatbot from '../components/Chatbot.astro';
import Popup from '../components/Popup.astro';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

// title/description are optional per-page overrides forwarded to <Seo/>, which
// applies the ported defaults (from src/lib/seo.js) when they are omitted. We do
// NOT default them here so a missing prop cleanly falls back inside the builder.
const { title, description, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Icons ported from the old site's index.html head. The SVG favicon is the
         modern primary; apple-touch-icon uses the full emblem for iOS home-screen
         bookmarks, and mask-icon tints the Safari pinned-tab glyph the brand
         saffron. All three live as static files in public/. theme-color is NOT
         set here on purpose: Seo.astro owns it (single source of truth). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#F5972A" />

    <!-- NO-FLASH THEME
         Runs synchronously in <head>, before any body paint. It reads the saved
         choice ('theme' in localStorage) and, only when nothing is saved, falls
         back to the OS preference. Setting the `dark` class here (rather than in
         a deferred script) is what prevents the light-mode flash on load. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          /* private mode / storage disabled — default to light, no crash */
        }
      })();
    </script>

    <!-- FULL SEO / social-link-preview parity with the old site. Driven by the
         shared config (siteUrl) + optional per-page title/description props, all
         with fail-safe defaults ported from the old index.html. -->
    <Seo title={title} description={description} />

    <!-- VIEW TRANSITIONS (client-side routing)
         WHY: this is a multi-page static site, so every nav click USED to be a
         full document load — which re-ran the announcement popup island on every
         internal tab switch (the reported bug). <ViewTransitions /> upgrades
         same-origin nav clicks into SPA-style client swaps (the <body> is
         swapped in place, no full reload), so the popup island does NOT re-fire
         on tab navigation. A first visit or a manual browser refresh (F5) is
         still a REAL document load, so the popup still shows exactly there.
         API NOTE: `ViewTransitions` imported from 'astro:transitions' is the
         correct export for astro ^4.16 (the `ClientRouter` name is the Astro 5
         rename; do NOT use it here). Because bundled <script> islands do NOT
         auto re-run on client swaps, each island documents its own
         persist-vs-re-init strategy (see Header/Chatbot/Popup/Analytics and the
         data pages' astro:page-load handlers). -->
    <ViewTransitions />

    <!-- PERFORMANCE: pre-connect to the font origins for a faster first fetch. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Fonts loaded NON-render-blocking (media=print + onload swap), with a
         <noscript> fallback. Keeps the font fetch off the critical path so it
         never delays LCP; `display=swap` shows fallback text meanwhile. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons+Round&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      />
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/icon?family=Material+Icons+Round"
      />
    </noscript>

    <!-- Per-page head extras (page-specific meta, JSON-LD, etc.). -->
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <!-- Skip link: first focusable element so keyboard/screen-reader users can
         jump past the header + nav straight to the page content. It is visually
         hidden (sr-only) until focused, then reveals as a brand-colored chip.
         The focus:not-sr-only utilities un-hide it only while focused. -->
    <a
      href="#main-content"
      class="sr-only rounded-md bg-brand-500 px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[70]"
    >
      Skip to main content
    </a>

    <!-- Analytics first in <body>: the GTM <noscript> iframe must be early, and
         the GTM loader self-boots on window 'load' from anywhere. -->
    <Analytics />
    <Header />
    <!-- pb-20 reserves space on mobile so page content is never hidden behind the
         fixed bottom-nav; removed at md (md:pb-0) where the nav moves into the
         header. Mirrors the old portal's body bottom padding for its 65px bar. -->
    <main id="main-content" class="pb-20 md:pb-0">
      <slot />
    </main>
    <!-- Floating chatbot: present on every page. -->
    <Chatbot />
    <!-- Announcement popup: fetched fresh on every load; non-render-blocking. -->
    <Popup />
  </body>
</html>
