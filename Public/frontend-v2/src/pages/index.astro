---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n.js';

const lang = 'en';
---

<Layout title="Chhath Puja Transparency Portal">
  <div id="home-loader" class="mx-auto max-w-6xl px-4 py-16 text-center text-slate-500 dark:text-slate-400">
    <span class="material-icons-round animate-spin align-middle" aria-hidden="true">progress_activity</span>
  </div>

  <div id="stale-data-notice" class="hidden"></div>

  <section id="home" class="mx-auto hidden max-w-6xl flex-col gap-8 px-4 py-8 sm:py-12" data-home-root>
    <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-white to-slate-50 p-5 shadow-sm dark:border-slate-800 dark:from-slate-900 dark:to-slate-950 sm:p-7">
      <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <h1 class="text-xl font-bold text-slate-900 dark:text-white sm:text-2xl" data-i18n="master_calc">{t(lang, 'master_calc')}</h1>
        <p id="disp-year-title" class="text-sm font-semibold text-brand-600 dark:text-brand-400">&nbsp;</p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <div id="lbl-past-loan" class="text-xs font-medium text-slate-500 dark:text-slate-400">{t(lang, 'past_loan_returned')}</div>
          <div id="h-past-loan" class="mt-1 text-lg font-bold text-slate-800 dark:text-slate-100">—</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <div id="lbl-cur-col" class="text-xs font-medium text-slate-500 dark:text-slate-400">{t(lang, 'current_year_collection')}</div>
          <div id="h-cur-col" class="mt-1 text-lg font-bold text-emerald-600 dark:text-emerald-400">—</div>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-4 dark:border-brand-900/50 dark:bg-brand-900/20">
          <div class="text-xs font-semibold text-brand-700 dark:text-brand-300" data-i18n="total_budget">{t(lang, 'total_budget')}</div>
          <div id="h-tot-bud" class="mt-1 text-xl font-extrabold text-brand-700 dark:text-brand-300">—</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400" data-i18n="total_expense">{t(lang, 'total_expense')}</div>
          <div id="h-tot-exp" class="mt-1 text-lg font-bold text-red-600 dark:text-red-400">—</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400" data-i18n="net_surplus">{t(lang, 'net_surplus')}</div>
          <div id="h-surplus" class="mt-1 text-lg font-bold text-slate-800 dark:text-slate-100">—</div>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white" data-i18n="contributors_list">{t(lang, 'contributors_list')}</h2>
        <input
          id="home-search"
          type="search"
          placeholder={t(lang, 'search_by_name')}
          data-i18n-placeholder="search_by_name"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 sm:w-64"
        />
      </div>
      <div id="home-col-list" class="divide-y divide-slate-100 dark:divide-slate-800"></div>
    </div>
  </section>
</Layout>

<script>
  import { apiBase } from '../config.js';
  import { computeBudget, fmt } from '../lib/finance.js';
  import { loadPortalData } from '../lib/portalData.js';
  import {
    buildUserMap,
    collectYears,
    renderContributorsList,
    staleNoticeText,
    coldFailureHtml,
  } from '../lib/homeRender.js';
  import { t, normalizeLang, LANG_KEY } from '../i18n.js';

  (function () {
    function currentLang() {
      try { return normalizeLang(localStorage.getItem(LANG_KEY)); } catch (e) { return 'en'; }
    }

    var state = { data: null, userMap: {}, savedAt: 0, fromCache: false };
    var sessionCache = {};

    var loaderEl = document.getElementById('home-loader');
    var homeEl = document.querySelector('[data-home-root]');
    var noticeEl = document.getElementById('stale-data-notice');
    var yearSel = document.getElementById('year-select');
    var searchEl = document.getElementById('home-search');

    function selectedYear() {
      var v = yearSel ? yearSel.value : '';
      return v === 'All' ? 'All' : parseInt(v);
    }

    function populateYears() {
      if (!yearSel) return;
      var years = collectYears(state.data);
      var opts = years.map(function (y) { return '<option value="' + y + '">' + y + '</option>'; });
      opts.push('<option value="All">' + t(currentLang(), 'lifetime_budget_overview') + '</option>');
      yearSel.innerHTML = opts.join('');
      yearSel.value = String(years[0]);
    }

    function renderHero() {
      var lang = currentLang();
      var year = selectedYear();
      var isAll = year === 'All';
      var d = state.data || {};

      var titleEl = document.getElementById('disp-year-title');
      if (titleEl) titleEl.textContent = isAll ? t(lang, 'lifetime_budget_overview') : (year + ' ' + t(lang, 'budget_overview'));
      var lblPast = document.getElementById('lbl-past-loan');
      if (lblPast) lblPast.textContent = isAll ? t(lang, 'lifetime_loans_returned') : t(lang, 'past_loan_returned');
      var lblCur = document.getElementById('lbl-cur-col');
      if (lblCur) lblCur.textContent = isAll ? t(lang, 'lifetime_collections') : t(lang, 'current_year_collection');

      var b = computeBudget(d.collections, d.loans, d.expenses, year);
      var set = function (id, text) { var el = document.getElementById(id); if (el) el.textContent = text; };
      set('h-past-loan', fmt(b.pastLoanReturned));
      set('h-cur-col', '+' + fmt(b.currentCollection));
      set('h-tot-bud', fmt(b.totalBudget));
      set('h-tot-exp', fmt(b.totalExpense));
      set('h-surplus', fmt(b.netSurplus));
    }

    function renderList() {
      var lang = currentLang();
      var year = selectedYear();
      var isAll = year === 'All';
      var d = state.data || {};
      var rows = isAll ? (d.collections || []) : (d.collections || []).filter(function (c) { return parseInt(c.Year) === year; });
      var listEl = document.getElementById('home-col-list');
      if (listEl) listEl.innerHTML = renderContributorsList(rows, state.userMap, lang, isAll, searchEl ? searchEl.value : '');
    }

    function renderAll() { renderHero(); renderList(); }

    function refreshEls() {
      loaderEl = document.getElementById('home-loader');
      homeEl = document.querySelector('[data-home-root]');
      noticeEl = document.getElementById('stale-data-notice');
      yearSel = document.getElementById('year-select');
      searchEl = document.getElementById('home-search');
    }

    function renderStaleNotice() {
      if (!noticeEl) return;
      if (!state.fromCache) { noticeEl.classList.add('hidden'); noticeEl.textContent = ''; return; }
      noticeEl.className = 'bg-amber-100 px-3 py-1.5 text-center text-sm leading-snug text-amber-800 dark:bg-amber-900/40 dark:text-amber-200';
      noticeEl.setAttribute('role', 'status');
      noticeEl.textContent = staleNoticeText(currentLang(), state.savedAt);
    }

    function renderColdFailure() {
      if (!loaderEl) return;
      loaderEl.innerHTML = coldFailureHtml(currentLang());
      loaderEl.classList.remove('hidden');
      var btn = loaderEl.querySelector('[data-cold-retry]');
      if (btn) btn.addEventListener('click', function () { location.reload(); });
    }

    function onLangChange() {
      populateYears();
      if (searchEl) searchEl.setAttribute('placeholder', t(currentLang(), 'search_by_name'));
      renderAll();
      renderStaleNotice();
    }

    async function boot() {
      try {
        var result = await loadPortalData({ apiBase: apiBase, sessionCache: sessionCache });
        state.data = result.data || {};
        state.userMap = buildUserMap(state.data.users);
        state.fromCache = !!result.fromCache;
        state.savedAt = result.savedAt || 0;

        populateYears();
        if (searchEl) searchEl.setAttribute('placeholder', t(currentLang(), 'search_by_name'));
        renderAll();
        renderStaleNotice();

        if (loaderEl) loaderEl.classList.add('hidden');
        if (homeEl) { homeEl.classList.remove('hidden'); homeEl.classList.add('flex'); }
      } catch (e) {
        renderColdFailure();
      }
    }

    document.addEventListener('astro:page-load', function () {
      if (!document.querySelector('[data-home-root]')) return;
      refreshEls();
      boot();
      if (yearSel) yearSel.addEventListener('change', renderAll);
      if (searchEl) searchEl.addEventListener('input', renderList);
    });

    if (!window.__cpmHomeLangBound) {
      window.__cpmHomeLangBound = true;
      window.addEventListener('cpm:langchange', onLangChange);
    }
  })();
</script>
