---
// Home page for the v2 public portal.
//
// PHASE 1 SCOPE: a minimal but real, responsive, theme- and i18n-aware page so
// `astro build` produces a valid site. Full data wiring (budget overview,
// contributors, ledgers, chatbot) lands in Phase 2. The hero below uses the
// ported i18n strings and brand palette + dark: variants so the theme toggle is
// visibly exercised from the first build.
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n.js';

const lang = 'en';
---

<Layout title="Chhath Puja Transparency Portal">
  <section
    id="home"
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-16 text-center sm:py-24"
  >
    <img src="/logo.svg" alt="" width="72" height="72" class="h-16 w-16 sm:h-20 sm:w-20" decoding="async" />

    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      <span data-i18n="app_title">{t(lang, 'app_title')}</span>
      <span class="text-brand-500"> · </span>
      <span data-i18n="app_subtitle">{t(lang, 'app_subtitle')}</span>
    </h1>

    <p class="max-w-2xl text-base text-slate-600 dark:text-slate-300">
      Navyuvak Chhath Puja Samiti, Shaharpura &amp; Gardih (Giridih, Jharkhand).
      Full public transparency for collections, expenses, loans and committee
      details.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="#expenses"
        class="rounded-lg bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-600"
        data-i18n="budget_overview"
      >
        {t(lang, 'budget_overview')}
      </a>
      <a
        href="#downloads"
        class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-brand-500 hover:text-brand-600 dark:border-slate-700 dark:text-slate-200"
        data-i18n="download_center"
      >
        {t(lang, 'download_center')}
      </a>
    </div>
  </section>
</Layout>
