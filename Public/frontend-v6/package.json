{
  "name": "chhath-public-frontend-v6",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chhath Puja Transparency Portal — v6 (SvelteKit + TypeScript + Tailwind, static, PWA). Skin-based multi-portal: selecting a theme swaps the entire portal layout over one shared data layer. Consumes the UNCHANGED Cloudflare Worker public API.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.3",
    "@vite-pwa/sveltekit": "^1.1.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.45.0",
    "zod": "^3.23.8"
  }
}
